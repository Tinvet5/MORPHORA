{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphora.cl/schemas/histology-slide.schema.json",
  "title": "MORPHORA Histology Slide Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "classification",
    "source",
    "image",
    "objective",
    "structures"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "$ref": "#/$defs/localizedText"
    },
    "subtitle": {
      "$ref": "#/$defs/localizedText"
    },
    "classification": {
      "type": "object",
      "required": [
        "branch",
        "species",
        "system",
        "organ",
        "stain"
      ],
      "properties": {
        "branch": {
          "enum": [
            "histology",
            "histopathology",
            "unclassified"
          ]
        },
        "species": {
          "$ref": "#/$defs/classifiedLabel"
        },
        "system": {
          "$ref": "#/$defs/classifiedLabel"
        },
        "organ": {
          "$ref": "#/$defs/classifiedLabel"
        },
        "diagnosis": {
          "$ref": "#/$defs/localizedText"
        },
        "stain": {
          "$ref": "#/$defs/classifiedLabel"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "pma-start",
            "dzi",
            "iiif",
            "custom-tiles"
          ]
        },
        "serverUrl": {
          "type": "string"
        },
        "slidePath": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "tileSource": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "width",
        "height",
        "tileSize",
        "micrometresPerPixelX",
        "micrometresPerPixelY"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "tileSize": {
          "type": "integer",
          "minimum": 64
        },
        "maxZoomLevel": {
          "type": "integer",
          "minimum": 1
        },
        "micrometresPerPixelX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "micrometresPerPixelY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "format": {
          "type": "string"
        },
        "compression": {
          "type": "string"
        }
      }
    },
    "objective": {
      "type": "object",
      "required": [
        "nativeMagnification",
        "presets"
      ],
      "properties": {
        "nativeMagnification": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/structure"
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "hosted",
            "local"
          ]
        },
        "hosted": {
          "type": "object",
          "properties": {
            "type": {
              "const": "dzi"
            },
            "descriptorUrl": {
              "type": "string"
            },
            "barcodeUrl": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "fallback": {
          "type": "object",
          "properties": {
            "type": {
              "const": "pma-start"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": [
        "es",
        "en"
      ],
      "properties": {
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "classifiedLabel": {
      "type": "object",
      "required": [
        "id",
        "es",
        "en"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "structure": {
      "type": "object",
      "required": [
        "id",
        "name",
        "geometry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "category": {
          "type": "string"
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "x",
                "y"
              ],
              "properties": {
                "type": {
                  "const": "point"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "points"
              ],
              "properties": {
                "type": {
                  "const": "polygon"
                },
                "points": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
